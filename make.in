# COMPILER AND COMPILER FLAGS
CXX=g++
CXXFLAGS:=$(CXXFLAGS) -g -O3 -funroll-loops 

# AUTOMATIC DEPENDENCY GENERATION
MAKEDEPEND=g++ -M $(CXXFLAGS)

# INCLUDES AND LINKER FLAGS
# Lapack includes and linking

ILAPACK=
LLAPACK=-llapack

TBSRC=../libs/
LDFLAGS=-L$(TBSRC) -ltoolbox $(LLAPACK)
CXXFLAGS:=$(CXXFLAGS) -I$(TBSRC) $(ILAPACK)

LLAPACK=-framework Accelerate
